rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anyone signed in can read batch uploads (this matches Firestore rules).
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      // Only the owning user can write to their own folder. Cap individual
      // uploads at 50 MB to stay inside Firebase's free tier comfortably.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
